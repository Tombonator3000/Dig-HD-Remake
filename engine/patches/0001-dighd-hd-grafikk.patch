+/*
+ * Dig HD: HD replacement graphics for The Dig.
+ *
+ * The engine keeps running in 320x200 with 256 colours. Every time a
+ * finished 8-bit area is sent to the screen, this class builds the same
+ * area at N times the resolution in full colour:
+ *
+ *  - pixels that still show the untouched room background are taken from
+ *    an HD room image (mods/<name>/rooms/roomNNN.png),
+ *  - pixels that show an object image (doors, machines) are taken from an
+ *    HD object image (mods/<name>/objects/objNNN_SS.png),
+ *  - pixels of a costume cel come from mods/<name>/costumes/costumeCCC_NNN.png,
+ *  - film frames come from mods/<name>/san/<FILE>/NNNNN.png, except the
+ *    pixels of text (subtitles) that SmushPlayer draws over the film,
+ *  - everything else (text, effects) is the original pixel scaled up.
+ *
+ * Which pixels are "untouched background" is decided by comparing against
+ * the original 8-bit image shipped next to each HD image (*_idx.png). When
+ * the palette changes (fades, light switches), the HD pixel is tinted by the
+ * ratio between the current and the original colour. Where colours cycle
+ * (water, energy), that ratio is interpolated smoothly between the original
+ * pixels, so the HD image follows the cycling without a grid of blocks.
+ *
+ * While playing, Ctrl+H switches between HD and classic graphics (the
+ * original pixels scaled up, same screen size) and Ctrl+Shift+H puts a
+ * yellow tint on pixels that are shown as original pixels because no HD
+ * image exists for them.
+ */
+
+#ifndef SCUMM_DIGHD_H
+#define SCUMM_DIGHD_H
+
+#include "common/array.h"
+#include "common/hashmap.h"
+#include "common/keyboard.h"
+#include "common/path.h"
+#include "common/str.h"
+#include "graphics/pixelformat.h"
+#include "graphics/surface.h"
+
+namespace Scumm {
+
+class ScummEngine;
+struct VirtScreen;
+
+class DigHD {
+public:
+	/** Returns nullptr unless HD mode is requested (DIGHD_MOD / dighd_mod). */
+	static DigHD *create(ScummEngine *vm);
+	~DigHD();
+
+	int scale() const { return _scale; }
+
+	/** Replaces initGraphics() for the game screen. */
+	bool initGraphics(int width, int height);
+
+	/** Final blit of a virtual screen area (front buffer), see drawStripToScreen(). */
+	void blitVirtScreen(VirtScreen *vs, const byte *src, int pitch, int x, int y, int top, int width, int height);
+	/** Plain 8-bit blit without any HD lookup (effects, menus). */
+	void blit8(const byte *src, int pitch, int x, int y, int width, int height);
+	/** SMUSH frame blit; uses mods/<name>/san/<FILE>/<frame>.png when present. */
+	void blitSmush(const byte *src, int pitch, int width, int height, const Common::String &file, int frame);
+
+	/**
+	 * Text over SMUSH frames (subtitles). SmushPlayer draws text straight into
+	 * its 8-bit frame buffer. The same text is also drawn into the layer from
+	 * smushTextBegin(), which holds the frame with every byte inverted; after
+	 * both draws, the pixels where layer and frame are equal are exactly the
+	 * pixels the text wrote. These stay original pixels over an HD frame.
+	 */
+	byte *smushTextBegin(const byte *frame, int pitch, int height);
+	void smushTextEnd(const byte *frame);
+	/** A new picture was decoded into the SMUSH frame buffer: no text on it yet. */
+	void smushClearText();
+
+	void setPalette(const byte *colors, uint first, uint num);
+	void moveScreen(int dx, int dy, int height);
+	void updateCursor(const byte *cursor, int width, int height, int hotspotX, int hotspotY, int transColor);
+	void noteObject(int obj, int state, int x, int y, int width, int height);
+
+	/** An actor is about to be drawn (costume renderer). */
+	void beginActor(int actor, int costume);
+	/** A costume cel was painted. Coordinates are in costume renderer space. */
+	void noteCel(int cel, int left, int top, int width, int height, bool mirror, int xstart);
+
+	/** Called right before OSystem::updateScreen(); handles frame dumps and test hooks. */
+	void beforeUpdateScreen();
+
+	/**
+	 * Hotkeys while the game runs: Ctrl+H switches between HD and classic
+	 * graphics, Ctrl+Shift+H turns the yellow marking of missing HD on and off.
+	 * Returns true when the key was used here and must not reach the game.
+	 */
+	bool handleKey(const Common::KeyState &kbd, bool repeat);
+	void setClassic(bool on);
+	void setShowMissing(bool on);
+
+private:
+	explicit DigHD(ScummEngine *vm);
+
+	struct Image {
+		Graphics::Surface hd;   // RGBA32, scale x original
+		Graphics::Surface idx;  // CLUT8, original size
+		byte basePal[768];
+		int transparent = -1;
+		Common::Array<byte> nearCycle;  // per original pixel: cycles or touches a cycled pixel
+		uint32 nearCycleGen = 0;        // _cycledGen the mask was made for
+		bool valid() const { return hd.getPixels() && idx.getPixels(); }
+		void free();
+	};
+
+	struct CelSlot {
+		bool used = false;
+		int costume = 0, cel = 0;
+		Image *image = nullptr;
+		int rx = 0, ry = 0, rw = 0, rh = 0;  // on-screen rect in room coordinates
+		bool mirror = false;
+		bool missing = false;  // drawn, but there is no HD image for this cel
+		uint32 seq = 0;
+	};
+	enum { kCelSlotsPerActor = 32, kMaxCelSlots = 1024 };
+
+	struct DrawnObject {
+		int obj, state, x, y;
+		Image *image;
+		uint32 seq;
+	};
+
+	bool loadImage(const Common::Path &hdFile, const Common::Path &idxFile, int origW, int origH, Image &out);
+	void loadRoom(int room);
+	void clearRoom();
+	void markMissingCels(VirtScreen *vs, const byte *src, int pitch, const byte *back, int x, int y, int top, int width, int height);
+	void compose(int x, int y, int width, int height);
+	void kindFlat(byte *out, int outPitch, byte idx, bool missing);
+	void updateCycled();
+	const byte *nearCycleMask(Image &img);
+	void updateCycleTable(const Image &img);
+	void composeCycled(byte *out, int outPitch, const Image &img, int ix, int iy);
+	void writeRect(int x, int y, int width, int height);
+	void redrawColors(const bool *changed);
+	void recomputeTint();
+	uint32 tinted(uint32 rgba, byte idx, const byte *basePal) const;
+	void dumpFrame();
+
+	ScummEngine *_vm;
+	Common::Path _modPath;
+	int _scale = 4;
+	int _w = 0, _h = 0;
+	Graphics::PixelFormat _fmt;
+	Graphics::PixelFormat _rgba;
+
+	// What the original engine would have shown, per screen pixel
+	Common::Array<byte> _shadow;
+	// Where an HD pixel comes from: 0 = original pixel, else packed room/object coordinates
+	Common::Array<uint32> _source;
+	Common::Array<byte> _outBuf;
+
+	byte _pal[768];
+	uint32 _palVersion = 1;  // counts palette changes
+	bool _cursorPending = false;
+
+	// Colour cycling (CYCL): the palette indices that cycle now. Room and object
+	// HD pixels that cycle or touch a cycled pixel (Image::nearCycle) follow the
+	// cycling through a smooth colour map, see composeCycled().
+	bool _cycled[256];
+	bool _anyCycled = false;
+	uint32 _cycledGen = 1;            // changes with _cycled
+	float _cycleTap[3][8];            // quadratic B-spline weight of each of 3 taps per HD sub pixel
+	Common::Array<byte> _cycleArea;   // per screen pixel: 1 if the last compose used the colour map,
+	                                  // which depends on the colours around it (see redrawColors())
+	// Per palette index for the image's palette and the current palette: HD * gain + add
+	enum { kCycleChanged = 1, kCycleAdd = 2 };
+	float _cycleGain[256][3], _cycleAdd[256][3];
+	byte _cycleFlags[256];
+	const byte *_cycleTableBase = nullptr;  // basePal of the image the table was made for
+	byte _cycleTableColors[768];            // and its colours
+	uint32 _cycleTablePal = 0;              // _palVersion the table was made for
+
+	int _room = -1;
+	Image _roomImage;
+	Common::HashMap<uint32, Image *> _objectImages;  // key: obj << 8 | state
+	Common::Array<DrawnObject> _drawn;
+
+	// Costume cels
+	Image *celImage(int costume, int cel, int width, int height);
+	Common::HashMap<uint32, Image *> _celImages;  // key: costume << 12 | cel
+	CelSlot _cels[kMaxCelSlots];
+	int _curActor = -1, _curCostume = -1, _curCelCount = 0;
+	bool _passStarted = false;
+	uint32 _seq = 0;
+
+	// Smush frame replacement
+	Common::String _smushFile;
+	int _smushFrameNo = -1;             // frame shown last, numbered as the files in san/<FILE>/
+	Graphics::Surface _smushFrame;      // HD frame in screen format, used for kSrcSan pixels
+	bool _smushLoaded = false;          // _smushFrame belongs to the frame shown last
+	Common::Array<byte> _smushTextLayer;
+	Common::Array<byte> _smushText;     // 1 where the SMUSH frame buffer holds text
+	const byte *_smushTextBase = nullptr;
+	bool _smushHasText = false;
+
+	// Display modes (hotkeys, DIGHD_CLASSIC, DIGHD_SHOW_MISSING)
+	bool _classic = false;      // every pixel is the original pixel scaled up
+	bool _showMissing = false;  // yellow tint where HD is missing
+
+	// Test and debug hooks (environment variables)
+	struct TestKey {
+		int frame;
+		Common::KeyCode keycode;
+		byte flags;
+	};
+	Common::Array<TestKey> _testKeys;  // DIGHD_TEST_KEYS
+	uint32 _frameNo = 0;
+	Common::Path _dumpDir;
+	int _dumpEvery = 0;
+	int _bench = 0;  // DIGHD_BENCH: build the whole screen this many times at each dump and log the time
+	int _testRoom = -1, _testAt = -1, _testCamX = -1, _quitAt = -1;
+	bool _skipVideo = false, _testDone = false, _verify = false, _forceFlat = false;
+	uint32 _statRoom = 0, _statObject = 0, _statCel = 0, _statSan = 0, _statFlat = 0, _statMissing = 0, _statCycle = 0;
+	Common::String statText() const;
+};
+
+} // End of namespace Scumm
+
+#endif
