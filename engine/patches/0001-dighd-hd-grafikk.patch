+bool DigHD::initGraphics(int width, int height) {
+	_w = width;
+	_h = height;
+	_shadow.resize(_w * _h);
+	_source.resize(_w * _h);
+	_cycleArea.resize(_w * _h);
+	memset(_shadow.data(), 0, _shadow.size());
+	memset(_source.data(), 0, _source.size() * sizeof(uint32));
+	memset(_cycleArea.data(), 0, _cycleArea.size());
+
+	// Prefer a 32 bit mode, fall back to 16 bit.
+	Common::List<Graphics::PixelFormat> formats = g_system->getSupportedFormats();
+	Graphics::PixelFormat chosen;
+	for (const Graphics::PixelFormat &f : formats) {
+		if (f.bytesPerPixel == 4) {
+			chosen = f;
+			break;
+		}
+	}
+	if (chosen.bytesPerPixel != 4) {
+		for (const Graphics::PixelFormat &f : formats) {
+			if (f.bytesPerPixel == 2) {
+				chosen = f;
+				break;
+			}
+		}
+	}
+	if (chosen.bytesPerPixel < 2) {
+		warning("DigHD: no RGB screen mode available");
+		return false;
+	}
+	::initGraphics(_w * _scale, _h * _scale, &chosen);
+	_fmt = g_system->getScreenFormat();
+	if (_fmt.bytesPerPixel < 2) {
+		warning("DigHD: backend refused RGB mode");
+		return false;
+	}
+	_outBuf.resize(_w * _scale * _h * _scale * _fmt.bytesPerPixel);
+	debug("DigHD: screen %dx%d, %d bytes per pixel", _w * _scale, _h * _scale, _fmt.bytesPerPixel);
+	return true;
+}
+
+// ---------------------------------------------------------------- loading
+
+// ScummVM's PNG decoder keeps a paletted image in 8 bit only when its
+// transparency chunk (tRNS) makes palette index 0 alone transparent. BOMP
+// images (costumes with codec 5, inventory objects) are transparent at index
+// 255, which takes 256 tRNS entries, and the decoder would turn them into RGBA.
+// So the index image is decoded without its tRNS chunk, and the transparent
+// index (the first entry with alpha 0) is read from the chunk here.
+static Common::SeekableReadStream *withoutTRNS(Common::SeekableReadStream &in, int &transparent) {
+	transparent = -1;
+	const uint32 size = in.size();
+	if (size < 8)
+		return nullptr;
+	byte *data = (byte *)malloc(size);
+	if (!data || in.read(data, size) != size) {
+		free(data);
+		return nullptr;
+	}
+	// Chunks after the 8 byte signature: length, type, data, CRC
+	uint32 out = 8, p = 8;
+	while (p + 12 <= size) {
+		const uint32 len = READ_BE_UINT32(data + p);
+		if (len > size - p - 12)
+			break;
+		if (READ_BE_UINT32(data + p + 4) == MKTAG('t', 'R', 'N', 'S')) {
+			for (uint32 i = 0; i < len && transparent < 0; i++)
+				if (data[p + 8 + i] == 0)
+					transparent = i;
+		} else {
+			if (out != p)
+				memmove(data + out, data + p, len + 12);
+			out += len + 12;
+		}
+		p += len + 12;
+	}
+	return new Common::MemoryReadStream(data, out, DisposeAfterUse::YES);
+}
+
+bool DigHD::loadImage(const Common::Path &hdFile, const Common::Path &idxFile, int origW, int origH, Image &out) {
+	Common::FSNode hdNode(_modPath.join(hdFile));
+	Common::FSNode idxNode(_modPath.join(idxFile));
+	if (!hdNode.exists() || !idxNode.exists())
+		return false;
+
+	::Image::PNGDecoder idxDec;
+	int transparent = -1;
+	Common::SeekableReadStream *raw = idxNode.createReadStream();
+	Common::SeekableReadStream *s = raw ? withoutTRNS(*raw, transparent) : nullptr;
+	delete raw;
+	bool ok = s && idxDec.loadStream(*s);
+	delete s;
+	if (!ok || idxDec.getSurface()->format.bytesPerPixel != 1) {
+		warning("DigHD: %s is not an 8-bit indexed PNG", idxFile.toString().c_str());
+		return false;
+	}
+	const Graphics::Surface *is = idxDec.getSurface();
+	if ((origW > 0 && is->w != origW) || (origH > 0 && is->h != origH)) {
+		warning("DigHD: %s is %dx%d, expected %dx%d", idxFile.toString().c_str(), is->w, is->h, origW, origH);
+		return false;
+	}
+
+	::Image::PNGDecoder hdDec;
+	s = hdNode.createReadStream();
+	ok = s && hdDec.loadStream(*s);
+	delete s;
+	if (!ok)
+		return false;
+	const Graphics::Surface *hs = hdDec.getSurface();
+	if (hs->w != is->w * _scale || hs->h != is->h * _scale) {
+		warning("DigHD: %s is %dx%d, expected %dx%d", hdFile.toString().c_str(), hs->w, hs->h, is->w * _scale, is->h * _scale);
+		return false;
+	}
+
+	out.free();
+	out.idx.copyFrom(*is);
+	memset(out.basePal, 0, sizeof(out.basePal));
+	const Graphics::Palette &pal = idxDec.getPalette();
+	memcpy(out.basePal, pal.data(), MIN<uint>(pal.size() * 3, sizeof(out.basePal)));
+	out.transparent = transparent;
+
+	const Graphics::Palette &hpal = hdDec.getPalette();
+	Graphics::Surface *conv = hs->convertTo(_rgba, hpal.size() ? hpal.data() : nullptr, hpal.size());
+	out.hd.copyFrom(*conv);
+	conv->free();
+	delete conv;
+	return true;
+}
+
+void DigHD::clearRoom() {
+	// Screen pixels that point into the images of the old room would read
+	// freed memory (a fade in the new room can rebuild the screen before it
+	// is drawn again). They show the original pixel until they are redrawn.
+	for (uint i = 0; i < _source.size(); i++)
+		if (_source[i] & kSrcMask)
+			_source[i] = kSrcFlat;
+	_roomImage.free();
+	_cycleTableBase = nullptr;  // a new image may get the same address
+	for (auto &it : _objectImages) {
+		if (it._value) {
+			it._value->free();
+			delete it._value;
+		}
+	}
+	_objectImages.clear();
+	_drawn.clear();
+	for (auto &it : _celImages) {
+		if (it._value) {
+			it._value->free();
+			delete it._value;
+		}
+	}
+	_celImages.clear();
+	for (int i = 0; i < kMaxCelSlots; i++)
+		_cels[i] = CelSlot();
+	_room = -1;
+}
+
+void DigHD::loadRoom(int room) {
+	clearRoom();
+	_room = room;
+	Common::Path hd(Common::String::format("rooms/room%03d.png", room));
+	Common::Path idx(Common::String::format("rooms/room%03d_idx.png", room));
+	if (loadImage(hd, idx, _vm->_roomWidth, _vm->_roomHeight, _roomImage))
+		debug("DigHD: room %d loaded (%dx%d)", room, _roomImage.hd.w, _roomImage.hd.h);
+	else
+		debug("DigHD: no HD background for room %d", room);
+}
+
+void DigHD::noteObject(int obj, int state, int x, int y, int width, int height) {
+	if (_vm->_currentRoom != _room)
+		loadRoom(_vm->_currentRoom);
+	if (state <= 0)
+		return;
+
+	uint32 key = ((uint32)obj << 8) | (uint32)state;
+	Image *img = nullptr;
+	if (!_objectImages.tryGetVal(key, img)) {
+		img = new Image();
+		Common::Path hd(Common::String::format("objects/obj%03d_%02X.png", obj, state));
+		Common::Path idx(Common::String::format("objects/obj%03d_%02X_idx.png", obj, state));
+		if (!loadImage(hd, idx, width, height, *img)) {
+			delete img;
+			img = nullptr;
+		}
+		_objectImages[key] = img;
+	}
+
+	// One stable slot per object for the current room. The slot index is
+	// stored per pixel, so slots are never moved or removed until the room changes.
+	for (uint i = 0; i < _drawn.size(); i++) {
+		if (_drawn[i].obj == obj) {
+			_drawn[i].state = state;
+			_drawn[i].x = x;
+			_drawn[i].y = y;
+			_drawn[i].image = img;
+			_drawn[i].seq = ++_seq;
+			return;
+		}
+	}
+	if (_drawn.size() < 255) {
+		DrawnObject d = { obj, state, x, y, img, ++_seq };
+		_drawn.push_back(d);
+	}
+}
+
+DigHD::Image *DigHD::celImage(int costume, int cel, int width, int height) {
+	const uint32 key = ((uint32)costume << 12) | (uint32)cel;
+	Image *img = nullptr;
+	if (_celImages.tryGetVal(key, img))
+		return img;
+	img = new Image();
+	Common::Path hd(Common::String::format("costumes/costume%03d_%03d.png", costume, cel));
+	Common::Path idx(Common::String::format("costumes/costume%03d_%03d_idx.png", costume, cel));
+	if (!loadImage(hd, idx, width, height, *img)) {
+		delete img;
+		img = nullptr;
+	}
+	_celImages[key] = img;
+	return img;
+}
+
+void DigHD::beginActor(int actor, int costume) {
+	_curActor = actor;
+	_curCostume = costume;
+	_passStarted = false;
+}
+
+void DigHD::noteCel(int cel, int left, int top, int width, int height, bool mirror, int xstart) {
+	if (_curActor < 0 || _curActor * kCelSlotsPerActor >= kMaxCelSlots || width <= 0 || height <= 0)
+		return;
+	if (_vm->_currentRoom != _room)
+		loadRoom(_vm->_currentRoom);
+	CelSlot *base = &_cels[_curActor * kCelSlotsPerActor];
+	if (!_passStarted) {
+		// New drawing pass for this actor: its earlier cels are being replaced
+		for (int i = 0; i < kCelSlotsPerActor; i++)
+			base[i].used = base[i].missing = false;
+		_curCelCount = 0;
+		_passStarted = true;
+	}
+	if (_curCelCount >= kCelSlotsPerActor)
+		return;
+
+	// The cel's size in the costume (unscaled) comes from the original image
+	Image *img = celImage(_curCostume, cel, -1, -1);
+	CelSlot &c = base[_curCelCount++];
+	c.used = img != nullptr;
+	c.missing = img == nullptr;
+	c.costume = _curCostume;
+	c.cel = cel;
+	c.image = img;
+	// The renderer draws into a buffer shifted by (xstart & 7); convert to room coordinates
+	c.rx = left - (xstart & 7) + xstart;
+	c.ry = top;
+	c.rw = width;
+	c.rh = height;
+	c.mirror = mirror;
+	c.seq = ++_seq;
+}
+
+// ---------------------------------------------------------------- blits
+
+void DigHD::blitVirtScreen(VirtScreen *vs, const byte *src, int pitch, int x, int y, int top, int width, int height) {
+	if (_vm->_currentRoom != _room)
+		loadRoom(_vm->_currentRoom);
+
+	const bool mapping = vs->number == kMainVirtScreen && vs->hasTwoBuffers && !_vm->isSmushActive();
+	const byte *back = mapping ? vs->getBackPixels(x, top) : nullptr;
+	const bool haveRoom = mapping && _roomImage.valid();
+	const int roomW = haveRoom ? _roomImage.idx.w : 0;
+	const int roomH = haveRoom ? _roomImage.idx.h : 0;
+
+	int active[kMaxCelSlots];
+	int numActive = 0;
+	if (mapping)
+		for (int i = 0; i < kMaxCelSlots; i++)
+			if (_cels[i].used)
+				active[numActive++] = i;
+
+	for (int r = 0; r < height; r++) {
+		const int sy = y + r;
+		if (sy < 0 || sy >= _h)
+			continue;
+		const byte *f = src + r * pitch;
+		const byte *b = back ? back + r * vs->pitch : nullptr;
+		const int ry = top + r;
+		for (int c = 0; c < width; c++) {
+			const int sx = x + c;
+			if (sx < 0 || sx >= _w)
+				continue;
+			const byte idx = f[c];
+			uint32 source = kSrcFlat;
+
+			if (b && b[c] != idx && numActive) {
+				// Something was drawn over the background: is it a costume cel?
+				const int rx = vs->xstart + x + c;
+				uint32 bestSeq = 0;
+				for (int k = 0; k < numActive; k++) {
+					const CelSlot &cs = _cels[active[k]];
+					if (cs.seq < bestSeq)
+						continue;
+					const int lx = rx - cs.rx, ly = ry - cs.ry;
+					if (lx < 0 || ly < 0 || lx >= cs.rw || ly >= cs.rh || lx >= 1024 || ly >= 1024)
+						continue;
+					int cx = lx * cs.image->idx.w / cs.rw;
+					const int cy = ly * cs.image->idx.h / cs.rh;
+					if (cs.mirror)
+						cx = cs.image->idx.w - 1 - cx;
+					const byte code = *((const byte *)cs.image->idx.getBasePtr(cx, cy));
+					if ((int)code != cs.image->transparent) {
+						source = packCel(active[k], lx, ly);
+						bestSeq = cs.seq;
+					}
+				}
+			} else if (b && b[c] == idx) {
+				const int rx = vs->xstart + x + c;
+				if (haveRoom && rx >= 0 && rx < roomW && ry >= 0 && ry < roomH &&
+				    *((const byte *)_roomImage.idx.getBasePtr(rx, ry)) == idx) {
+					source = packRoom(rx, ry);
+				} else {
+					// Most recently drawn object image that matches this pixel.
+					// Without one, this background pixel has no HD image.
+					source = kSrcFlatMissing;
+					uint32 bestSeq = 0;
+					for (uint i = 0; i < _drawn.size(); i++) {
+						const DrawnObject &d = _drawn[i];
+						if (!d.image || d.seq < bestSeq)
+							continue;
+						const int ox = rx - d.x, oy = ry - d.y;
+						if (ox < 0 || oy < 0 || ox >= d.image->idx.w || oy >= d.image->idx.h)
+							continue;
+						const byte oi = *((const byte *)d.image->idx.getBasePtr(ox, oy));
+						if (oi == idx && (int)oi != d.image->transparent) {
+							source = packObject(i, ox, oy);
+							bestSeq = d.seq;
+						}
+					}
+				}
+			}
+			_shadow[sy * _w + sx] = idx;
+			_source[sy * _w + sx] = source;
+		}
+	}
+
+	if (mapping && _showMissing)
+		markMissingCels(vs, src, pitch, back, x, y, top, width, height);
+	writeRect(x, y, width, height);
+}
+
+void DigHD::markMissingCels(VirtScreen *vs, const byte *src, int pitch, const byte *back, int x, int y, int top, int width, int height) {
+	// Only while the yellow marking is on. An original pixel drawn over the
+	// background inside a cel that has no HD image is a figure pixel without HD.
+	// Outside such cels it is text or an effect, original on purpose.
+	int missing[kMaxCelSlots];
+	int numMissing = 0;
+	for (int i = 0; i < kMaxCelSlots; i++)
+		if (_cels[i].missing)
+			missing[numMissing++] = i;
+	if (!numMissing)
+		return;
+
+	for (int r = 0; r < height; r++) {
+		const int sy = y + r;
+		if (sy < 0 || sy >= _h)
+			continue;
+		const byte *f = src + r * pitch;
+		const byte *b = back + r * vs->pitch;
+		const int ry = top + r;
+		for (int c = 0; c < width; c++) {
+			const int sx = x + c;
+			if (sx < 0 || sx >= _w || b[c] == f[c] || _source[sy * _w + sx] != kSrcFlat)
+				continue;
+			const int rx = vs->xstart + x + c;
+			for (int k = 0; k < numMissing; k++) {
+				const CelSlot &cs = _cels[missing[k]];
+				const int lx = rx - cs.rx, ly = ry - cs.ry;
+				if (lx >= 0 && ly >= 0 && lx < cs.rw && ly < cs.rh) {
+					_source[sy * _w + sx] = kSrcFlatMissing;
+					break;
+				}
+			}
+		}
+	}
+}
+
+void DigHD::blit8(const byte *src, int pitch, int x, int y, int width, int height) {
+	for (int r = 0; r < height; r++) {
+		const int sy = y + r;
+		if (sy < 0 || sy >= _h)
+			continue;
+		for (int c = 0; c < width; c++) {
+			const int sx = x + c;
+			if (sx < 0 || sx >= _w)
+				continue;
+			_shadow[sy * _w + sx] = src[r * pitch + c];
+			_source[sy * _w + sx] = kSrcFlat;
+		}
+	}
+	writeRect(x, y, width, height);
+}
+
+void DigHD::blitSmush(const byte *src, int pitch, int width, int height, const Common::String &file, int frame) {
+	Common::String name = file;
+	int slash = name.findLastOf('/');
+	if (slash >= 0)
+		name = name.substr(slash + 1);
+	int dot = name.findLastOf('.');
+	if (dot >= 0)
+		name = name.substr(0, dot);
+	name.toUppercase();
+	if (name != _smushFile) {
+		_smushFile = name;
+		debug("DigHD: film %s", name.c_str());
+	}
+
+	// SmushPlayer has already counted the frame when it is shown, so the
+	// picture on screen is frame - 1 in the numbering used by the extractor
+	// (verified against thedig-textures output with DIGHD_VERIFY).
+	_smushFrameNo = frame - 1;
+	Common::FSNode node(_modPath.join(Common::String::format("san/%s/%05d.png", name.c_str(), frame - 1)));
+	const bool haveFrame = node.exists();
+
+	// Text drawn into this frame by SmushPlayer (see smushTextEnd). The mask
+	// has the layout of SmushPlayer's frame buffer, src may start inside it.
+	const byte *text = nullptr;
+	if (_smushHasText && _smushTextBase && src >= _smushTextBase) {
+		const size_t off = src - _smushTextBase;
+		if (off + (size_t)(MIN(height, _h) - 1) * pitch + MIN(width, _w) <= _smushText.size())
+			text = _smushText.data() + off;
+	}
+
+	// The HD frame is only read in HD mode; classic mode shows the original anyway
+	_smushLoaded = false;
+	if (haveFrame && !_classic) {
+		::Image::PNGDecoder dec;
+		Common::SeekableReadStream *s = node.createReadStream();
+		if (s && dec.loadStream(*s) && dec.getSurface()->w == _w * _scale && dec.getSurface()->h == _h * _scale) {
+			const Graphics::Palette &fpal = dec.getPalette();
+			Graphics::Surface *conv = dec.getSurface()->convertTo(_fmt, fpal.size() ? fpal.data() : nullptr, fpal.size());
+			_smushFrame.free();
+			_smushFrame = *conv;  // takes over the pixels
+			delete conv;
+			_smushLoaded = true;
+		}
+		delete s;
+	}
+
+	if (_smushLoaded && _verify) {
+		// Does the HD frame show the same picture as the original frame?
+		// A high share of differences means the frame numbers are shifted.
+		// Text pixels are not part of the HD frame and are left out.
+		uint32 bad = 0, n = 0;
+		for (int vy = 0; vy < MIN(height, _h); vy += 4) {
+			for (int vx = 0; vx < MIN(width, _w); vx += 4) {
+				if (text && text[vy * pitch + vx])
+					continue;
+				n++;
+				const byte i = src[vy * pitch + vx];
+				const byte *p = (const byte *)_smushFrame.getBasePtr(vx * _scale + _scale / 2, vy * _scale + _scale / 2);
+				const uint32 c = _fmt.bytesPerPixel == 4 ? READ_UINT32(p) : READ_UINT16(p);
+				byte r, g, b;
+				_fmt.colorToRGB(c, r, g, b);
+				if (ABS(r - _pal[i * 3]) > 48 || ABS(g - _pal[i * 3 + 1]) > 48 || ABS(b - _pal[i * 3 + 2]) > 48)
+					bad++;
+			}
+		}
+		debug("DigHD: verify SAN %s frame %d: %u of %u samples differ", name.c_str(), frame - 1, bad, n);
+	}
+
+	// Keep the 8-bit shadow up to date in any case (palette changes, dumps,
+	// classic mode). Text stays the original pixel on purpose, also over an
+	// HD frame. Everything else comes from the HD frame, and a frame without
+	// an HD version lacks HD as a whole.
+	const uint32 picture = _smushLoaded ? kSrcSan : (haveFrame ? kSrcFlat : kSrcFlatMissing);
+	for (int r = 0; r < height && r < _h; r++)
+		for (int c = 0; c < width && c < _w; c++) {
+			_shadow[r * _w + c] = src[r * pitch + c];
+			_source[r * _w + c] = (text && text[r * pitch + c]) ? kSrcFlat : picture;
+		}
+
+	writeRect(0, 0, MIN(width, _w), MIN(height, _h));
+}
+
+byte *DigHD::smushTextBegin(const byte *frame, int pitch, int height) {
+	const size_t size = (size_t)pitch * height;
+	if (!size || !frame)
+		return nullptr;
+	if (_smushText.size() != size || _smushTextBase != frame) {
+		_smushText.resize(size);
+		memset(_smushText.data(), 0, size);
+		_smushHasText = false;
+	}
+	_smushTextBase = frame;
+	_smushTextLayer.resize(size);
+	byte *layer = _smushTextLayer.data();
+	for (size_t i = 0; i < size; i++)
+		layer[i] = frame[i] ^ 0xFF;
+	return layer;
+}
+
+void DigHD::smushTextEnd(const byte *frame) {
+	// The text renderer only writes pixels, it never reads them. A pixel it
+	// wrote has the same value in both buffers, every other pixel differs.
+	const byte *layer = _smushTextLayer.data();
+	byte *mask = _smushText.data();
+	for (size_t i = 0; i < _smushText.size(); i++) {
+		if (layer[i] == frame[i]) {
+			mask[i] = 1;
+			_smushHasText = true;
+		}
+	}
+}
+
+void DigHD::smushClearText() {
+	if (_smushHasText)
+		memset(_smushText.data(), 0, _smushText.size());
+	_smushHasText = false;
+}
+
+// ---------------------------------------------------------------- composing
+
+uint32 DigHD::tinted(uint32 rgba, byte idx, const byte *basePal) const {
+	byte a, r, g, b;
+	_rgba.colorToARGB(rgba, a, r, g, b);
+	const byte *cur = _pal + idx * 3;
+	const byte *base = basePal + idx * 3;
+	if (cur[0] == base[0] && cur[1] == base[1] && cur[2] == base[2])
+		return _fmt.RGBToColor(r, g, b);
+	// Scale each channel by current/original; a channel that was black in the
+	// original cannot be scaled, so it takes the current colour directly.
+	int c[3] = { r, g, b };
+	for (int k = 0; k < 3; k++)
+		c[k] = base[k] ? MIN(255, c[k] * cur[k] / base[k]) : cur[k];
+	return _fmt.RGBToColor(c[0], c[1], c[2]);
+}
+
+// The original colour mixed half and half with yellow: marks a pixel without HD
+static inline uint32 missingColor(const Graphics::PixelFormat &fmt, const byte *rgb) {
+	return fmt.RGBToColor((rgb[0] + 255) >> 1, (rgb[1] + 255) >> 1, rgb[2] >> 1);
+}
+
+void DigHD::kindFlat(byte *out, int outPitch, byte idx, bool missing) {
+	const int bpp = _fmt.bytesPerPixel;
+	uint32 col;
+	if (missing) {
+		col = missingColor(_fmt, _pal + idx * 3);
+		_statMissing++;
+	} else {
+		col = _fmt.RGBToColor(_pal[idx * 3], _pal[idx * 3 + 1], _pal[idx * 3 + 2]);
+	}
+	for (int dy = 0; dy < _scale; dy++) {
+		byte *o = out + dy * outPitch;
+		for (int dx = 0; dx < _scale; dx++, o += bpp) {
+			if (bpp == 4) WRITE_UINT32(o, col); else WRITE_UINT16(o, col);
+		}
+	}
+	_statFlat++;
+}
+
+void DigHD::updateCycled() {
+	bool cycled[256];
+	memset(cycled, 0, sizeof(cycled));
+	bool any = false;
+	for (int i = 0; i < 16; i++) {
+		const ColorCycle &cc = _vm->_colorCycle[i];
+		if (cc.delay && cc.start <= cc.end) {
+			for (int k = cc.start; k <= cc.end; k++)
+				cycled[k] = true;
+			any = true;
+		}
+	}
+	if (memcmp(cycled, _cycled, sizeof(cycled))) {
+		memcpy(_cycled, cycled, sizeof(cycled));
+		_cycledGen++;  // the masks of the images are made again when used
+	}
+	_anyCycled = any;
+}
+
+const byte *DigHD::nearCycleMask(Image &img) {
+	if (img.nearCycleGen == _cycledGen)
+		return img.nearCycle.data();
+	// Pixels that cycle or have a cycled pixel among their 8 neighbours: the
+	// colour map of composeCycled() reaches one original pixel around a cycled
+	// pixel. Transparent pixels of an object never count. Horizontal pass into
+	// rows, then vertical into the mask.
+	const int w = img.idx.w, h = img.idx.h;
+	Common::Array<byte> rows(w * h);
+	for (int y = 0; y < h; y++) {
+		const byte *p = (const byte *)img.idx.getBasePtr(0, y);
+		byte *o = rows.data() + y * w;
+		for (int x = 0; x < w; x++)
+			o[x] = (int)p[x] != img.transparent && _cycled[p[x]];
+	}
+	for (int y = 0; y < h; y++) {
+		byte *o = rows.data() + y * w;
+		byte left = 0;
+		for (int x = 0; x < w; x++) {
+			const byte self = o[x];
+			o[x] = left | self | (x + 1 < w ? o[x + 1] : 0);
+			left = self;
+		}
+	}
+	img.nearCycle.resize(w * h);
+	for (int y = 0; y < h; y++) {
+		const byte *up = rows.data() + MAX(y - 1, 0) * w;
+		const byte *mid = rows.data() + y * w;
+		const byte *down = rows.data() + MIN(y + 1, h - 1) * w;
+		byte *o = img.nearCycle.data() + y * w;
+		for (int x = 0; x < w; x++)
+			o[x] = up[x] | mid[x] | down[x];
+	}
+	img.nearCycleGen = _cycledGen;
+	return img.nearCycle.data();
+}
+
+void DigHD::updateCycleTable(const Image &img) {
+	if (_cycleTablePal == _palVersion) {
+		if (_cycleTableBase == img.basePal)
+			return;
+		// Room and object images usually share the room palette, and their pixels
+		// alternate on screen: a table for the same palette fits as it is.
+		if (!memcmp(_cycleTableColors, img.basePal, sizeof(_cycleTableColors))) {
+			_cycleTableBase = img.basePal;
+			return;
+		}
+	}
+	_cycleTableBase = img.basePal;
+	_cycleTablePal = _palVersion;
+	memcpy(_cycleTableColors, img.basePal, sizeof(_cycleTableColors));
+	// HD pixel = HD * gain + add, per palette index and channel, the same as
+	// tinted() for one pixel: an unchanged colour keeps the HD pixel, otherwise
+	// gain is the ratio current/original, and a channel that is black in the
+	// original takes the current value. Ratios above kMaxGain only come from
+	// nearly black original colours; there the detail of the HD image is raised
+	// at most this much and the rest of the change is added, as interpolating
+	// a very large gain would raise the noise around the pixel as well.
+	const float kMaxGain = 2.0f;
+	for (int k = 0; k < 256; k++) {
+		const byte *cp = _pal + k * 3, *bp = img.basePal + k * 3;
+		if (cp[0] == bp[0] && cp[1] == bp[1] && cp[2] == bp[2]) {
+			for (int ch = 0; ch < 3; ch++) {
+				_cycleGain[k][ch] = 1.0f;
+				_cycleAdd[k][ch] = 0.0f;
+			}
+			_cycleFlags[k] = 0;
+			continue;
+		}
+		byte flags = kCycleChanged;
+		for (int ch = 0; ch < 3; ch++) {
+			const float cur = cp[ch], base = bp[ch];
+			const float gain = base > 0.0f ? MIN(cur / base, kMaxGain) : 0.0f;
+			float add = cur - gain * base;
+			if (add > -0.01f && add < 0.01f)
+				add = 0.0f;  // rounding only
+			_cycleGain[k][ch] = gain;
+			_cycleAdd[k][ch] = add;
+			if (add != 0.0f)
+				flags |= kCycleAdd;
+		}
+		_cycleFlags[k] = flags;
+	}
+}
+
+void DigHD::composeCycled(byte *out, int outPitch, const Image &img, int ix, int iy) {
+	// One original pixel (ix, iy) of a room or object image that is colour cycled
+	// or touches a cycled pixel. Tinting each block by its own palette ratio, as
+	// tinted() does, shows the 4x4 blocks as a grid when neighbouring indices
+	// cycle to different colours. Instead the ratios (gain and add, see
+	// updateCycleTable()) of the 3 x 3 original pixels around it are interpolated
+	// to every HD sub pixel with a quadratic B-spline: smooth, with no edges at
+	// the block borders. A neighbour whose colour has not changed has gain 1, so
+	// the change fades out towards it within half an original pixel, and nothing
+	// outside the 3 x 3 pixels around a cycled pixel is touched.
+	updateCycleTable(img);
+	const int n = _scale, bpp = _fmt.bytesPerPixel;
+	const Graphics::PixelFormat fmt = _fmt;
+	const int w = img.idx.w, h = img.idx.h;
+	const byte centre = *(const byte *)img.idx.getBasePtr(ix, iy);
+	float gain[3][3][3], add[3][3][3];  // [row][column][channel]
+	byte flags = 0;
+	for (int j = 0; j < 3; j++) {
+		const byte *row = (const byte *)img.idx.getBasePtr(0, CLIP(iy + j - 1, 0, h - 1));
+		for (int i = 0; i < 3; i++) {
+			int k = row[CLIP(ix + i - 1, 0, w - 1)];
+			if (k == img.transparent)
+				k = centre;  // outside an object: use the pixel itself
+			for (int ch = 0; ch < 3; ch++) {
+				gain[j][i][ch] = _cycleGain[k][ch];
+				add[j][i][ch] = _cycleAdd[k][ch];
+			}
+			flags |= _cycleFlags[k];
+		}
+	}
+	// Local copies: the writes to the screen buffer below may alias members
+	float tap[3][8];
+	memcpy(tap, _cycleTap, sizeof(tap));
+	// HD images are in _rgba (RGBA32)
+	const int rs = _rgba.rShift, gs = _rgba.gShift, bs = _rgba.bShift;
+
+	for (int dy = 0; dy < n; dy++) {
+		byte *o = out + dy * outPitch;
+		const uint32 *hd = (const uint32 *)img.hd.getBasePtr(ix * n, iy * n + dy);
+		if (!(flags & kCycleChanged)) {
+			// No colour around here differs from the original: the HD image as it is
+			for (int dx = 0; dx < n; dx++, o += bpp) {
+				const uint32 c = hd[dx];
+				const uint32 col = fmt.RGBToColor((c >> rs) & 0xFF, (c >> gs) & 0xFF, (c >> bs) & 0xFF);
+				if (bpp == 4) WRITE_UINT32(o, col); else WRITE_UINT16(o, col);
+			}
+			continue;
+		}
+		// Vertical pass for the three columns, then horizontal for the sub pixels
+		// of this row (gain and add per channel), then the HD pixels.
+		const float wy0 = tap[0][dy], wy1 = tap[1][dy], wy2 = tap[2][dy];
+		float g[3][8], a[3][8];  // [channel][sub pixel], 0.5 for rounding is in a
+		for (int ch = 0; ch < 3; ch++) {
+			const float c0 = wy0 * gain[0][0][ch] + wy1 * gain[1][0][ch] + wy2 * gain[2][0][ch];
+			const float c1 = wy0 * gain[0][1][ch] + wy1 * gain[1][1][ch] + wy2 * gain[2][1][ch];
+			const float c2 = wy0 * gain[0][2][ch] + wy1 * gain[1][2][ch] + wy2 * gain[2][2][ch];
+			for (int dx = 0; dx < n; dx++)
+				g[ch][dx] = tap[0][dx] * c0 + tap[1][dx] * c1 + tap[2][dx] * c2;
+			if (flags & kCycleAdd) {
+				const float d0 = wy0 * add[0][0][ch] + wy1 * add[1][0][ch] + wy2 * add[2][0][ch];
+				const float d1 = wy0 * add[0][1][ch] + wy1 * add[1][1][ch] + wy2 * add[2][1][ch];
+				const float d2 = wy0 * add[0][2][ch] + wy1 * add[1][2][ch] + wy2 * add[2][2][ch];
+				for (int dx = 0; dx < n; dx++)
+					a[ch][dx] = tap[0][dx] * d0 + tap[1][dx] * d1 + tap[2][dx] * d2 + 0.5f;
+			} else {
+				for (int dx = 0; dx < n; dx++)
+					a[ch][dx] = 0.5f;
+			}
+		}
+		for (int dx = 0; dx < n; dx++, o += bpp) {
+			const uint32 c = hd[dx];
+			const int r = (int)((float)((c >> rs) & 0xFF) * g[0][dx] + a[0][dx]);
+			const int gr = (int)((float)((c >> gs) & 0xFF) * g[1][dx] + a[1][dx]);
+			const int b = (int)((float)((c >> bs) & 0xFF) * g[2][dx] + a[2][dx]);
+			const uint32 col = fmt.RGBToColor(CLIP(r, 0, 255), CLIP(gr, 0, 255), CLIP(b, 0, 255));
+			if (bpp == 4) WRITE_UINT32(o, col); else WRITE_UINT16(o, col);
+		}
+	}
+}
+
+void DigHD::compose(int x, int y, int width, int height) {
+	const int n = _scale;
+	const int bpp = _fmt.bytesPerPixel;
+	const int outPitch = width * n * bpp;
+	// Classic mode (and the verify pass) shows every pixel as the original pixel
+	const bool flatOnly = _forceFlat || _classic;
+	// Yellow marking of original pixels without HD; nothing is missing in classic mode
+	const bool showMissing = _showMissing && !flatOnly;
+	// HD film frame for kSrcSan pixels; after the film these are original pixels
+	const bool useSan = _smushLoaded && !flatOnly && _vm->isSmushActive();
+
+	// Colours that are being cycled (water, energy, lights) change all the time.
+	// Room and object HD pixels in and next to them go through composeCycled().
+	updateCycled();
+	const bool anyCycled = _anyCycled && !flatOnly;
+	const byte *roomNear = (anyCycled && _roomImage.valid()) ? nearCycleMask(_roomImage) : nullptr;
+	const int roomW = _roomImage.idx.w;
+
+	for (int r = 0; r < height; r++) {
+		const int sy = y + r;
+		for (int c = 0; c < width; c++) {
+			const int sx = x + c;
+			const byte idx = _shadow[sy * _w + sx];
+			const uint32 src = _source[sy * _w + sx];
+			const uint32 kind = src & kSrcMask;
+			byte *out = _outBuf.data() + (r * n) * outPitch + (c * n) * bpp;
+			_cycleArea[sy * _w + sx] = 0;
+
+			if (src == kSrcSan) {
+				// The film frame is shown as it was made, also for cycled colours
+				if (useSan) {
+					const byte *hdp = (const byte *)_smushFrame.getBasePtr(sx * n, sy * n);
+					for (int dy = 0; dy < n; dy++)
+						memcpy(out + dy * outPitch, hdp + dy * _smushFrame.pitch, n * bpp);
+					_statSan++;
+				} else {
+					kindFlat(out, outPitch, idx, false);
+				}
+				continue;
+			}
+
+			// A figure pixel in a cycled colour is an effect and stays the original pixel
+			if (flatOnly || kind == kSrcFlat || (kind == kSrcCel && _cycled[idx]) ||
+			    (kind == kSrcObject && (((src >> 22) & 0xFF) >= _drawn.size() || !_drawn[(src >> 22) & 0xFF].image))) {
+				uint32 col;
+				// Here an object source means an object without HD image. A cycled
+				// colour without HD is missing HD like any other pixel.
+				if (showMissing && (src == kSrcFlatMissing || kind == kSrcObject)) {
+					col = missingColor(_fmt, _pal + idx * 3);
+					_statMissing++;
+				} else {
+					col = _fmt.RGBToColor(_pal[idx * 3], _pal[idx * 3 + 1], _pal[idx * 3 + 2]);
+				}
+				for (int dy = 0; dy < n; dy++) {
+					byte *o = out + dy * outPitch;
+					for (int dx = 0; dx < n; dx++, o += bpp) {
+						if (bpp == 4) WRITE_UINT32(o, col); else WRITE_UINT16(o, col);
+					}
+				}
+				_statFlat++;
+				continue;
+			}
+
+			if (kind == kSrcCel) {
+				const CelSlot &cs = _cels[(src >> 20) & 0x3FF];
+				if (!cs.used || !cs.image) {
+					kindFlat(out, outPitch, idx, showMissing);
+					continue;
+				}
+				const int lx = src & 0x3FF, ly = (src >> 10) & 0x3FF;
+				const int cw = cs.image->idx.w, ch = cs.image->idx.h;
+				int cx = lx * cw / cs.rw;
+				const int cy = ly * ch / cs.rh;
+				if (cs.mirror)
+					cx = cw - 1 - cx;
+				const byte code = *((const byte *)cs.image->idx.getBasePtr(cx, cy));
+				const byte *truec = cs.image->basePal + code * 3;
+				const byte *shown = _pal + idx * 3;
+				// Tint factor between the colour the engine shows and the costume's
+				// true colour. Close enough means normal light: use the HD pixel as is.
+				// Very different means a special effect (shadow): keep the original pixel.
+				int f[3];
+				bool wild = false, plain = true;
+				for (int k = 0; k < 3; k++) {
+					const int t = truec[k], v = shown[k];
+					if (ABS(t - v) > 24)
+						plain = false;
+					if (t < 16) {
+						// A black channel cannot be scaled. Shown much brighter, the
+						// pixel is not this colour at all (another palette mapping,
+						// as for BOMP cels drawn with raw codes): keep the original.
+						f[k] = 256;
+						if (v > 48)
+							wild = true;
+					} else {
+						f[k] = v * 256 / t;
+						if (f[k] > 512 || (t > 64 && f[k] < 48))
+							wild = true;
+					}
+				}
+				if (wild) {
+					// Shadow or effect: original on purpose
+					kindFlat(out, outPitch, idx, false);
+					continue;
+				}
+				const uint32 flatCol = _fmt.RGBToColor(shown[0], shown[1], shown[2]);
+				for (int dy = 0; dy < n; dy++) {
+					byte *o = out + dy * outPitch;
+					const int hy = ((ly * n + dy) * ch) / cs.rh;
+					const uint32 *row = (const uint32 *)cs.image->hd.getBasePtr(0, MIN(hy, cs.image->hd.h - 1));
+					for (int dx = 0; dx < n; dx++, o += bpp) {
+						int hx = ((lx * n + dx) * cw) / cs.rw;
+						if (cs.mirror)
+							hx = cw * n - 1 - hx;
+						hx = CLIP(hx, 0, cs.image->hd.w - 1);
+						byte ha, hr, hg, hb;
+						_rgba.colorToARGB(row[hx], ha, hr, hg, hb);
+						uint32 col;
+						if (ha < 128)
+							col = flatCol;
+						else if (plain)
+							col = _fmt.RGBToColor(hr, hg, hb);
+						else
+							col = _fmt.RGBToColor(MIN(255, hr * f[0] >> 8), MIN(255, hg * f[1] >> 8), MIN(255, hb * f[2] >> 8));
+						if (bpp == 4) WRITE_UINT32(o, col); else WRITE_UINT16(o, col);
+					}
+				}
+				_statCel++;
+				continue;
+			}
+
+			Image *img;
+			int ix, iy;
+			bool nearCycle = false;
+			if (kind == kSrcRoom) {
+				img = &_roomImage;
+				ix = src & 0x7FFF;
+				iy = (src >> 15) & 0x7FFF;
+				nearCycle = roomNear && roomNear[iy * roomW + ix];
+				_statRoom++;
+			} else {
+				img = _drawn[(src >> 22) & 0xFF].image;
+				ix = src & 0x7FF;
+				iy = (src >> 11) & 0x7FF;
+				nearCycle = anyCycled && nearCycleMask(*img)[iy * img->idx.w + ix];
+				_statObject++;
+			}
+			if (nearCycle) {
+				composeCycled(out, outPitch, *img, ix, iy);
+				_cycleArea[sy * _w + sx] = 1;
+				_statCycle++;
+				continue;
+			}
+			const Graphics::Surface *hd = &img->hd;
+			const byte *basePal = img->basePal;
+			const int hx = ix * n, hy = iy * n;
+			for (int dy = 0; dy < n; dy++) {
+				byte *o = out + dy * outPitch;
+				const uint32 *t = (const uint32 *)hd->getBasePtr(hx, hy + dy);
+				for (int dx = 0; dx < n; dx++, o += bpp) {
+					const uint32 col = tinted(t[dx], idx, basePal);
+					if (bpp == 4) WRITE_UINT32(o, col); else WRITE_UINT16(o, col);
+				}
+			}
+		}
+	}
+}
+
+void DigHD::writeRect(int x, int y, int width, int height) {
+	if (x < 0) { width += x; x = 0; }
+	if (y < 0) { height += y; y = 0; }
+	width = MIN(width, _w - x);
+	height = MIN(height, _h - y);
+	if (width <= 0 || height <= 0)
+		return;
+	compose(x, y, width, height);
+	g_system->copyRectToScreen(_outBuf.data(), width * _scale * _fmt.bytesPerPixel,
+	                           x * _scale, y * _scale, width * _scale, height * _scale);
+}
+
+void DigHD::setPalette(const byte *colors, uint first, uint num) {
+	if (first >= 256)
+		return;
+	num = MIN<uint>(num, 256 - first);
+	if (!memcmp(_pal + first * 3, colors, num * 3))
+		return;
+	bool changed[256];
+	memset(changed, 0, sizeof(changed));
+	for (uint i = 0; i < num; i++)
+		changed[first + i] = memcmp(_pal + (first + i) * 3, colors + i * 3, 3) != 0;
+	memcpy(_pal + first * 3, colors, num * 3);
+	_palVersion++;
+	redrawColors(changed);
+	_cursorPending = true;
+}
+
+void DigHD::redrawColors(const bool *changed) {
+	// Only pixels shown in a changed colour look different now, and the pixels
+	// built with the colour map of composeCycled(), which also depend on the
+	// colours around them. With colour cycling that is often a small part of
+	// the screen. The screen is built again in bands of 8 rows, each band as
+	// wide as its changed pixels.
+	const uint32 gen = _cycledGen;
+	updateCycled();
+	if (_cycledGen != gen) {
+		// Other pixels go through the colour map from now on
+		writeRect(0, 0, _w, _h);
+		return;
+	}
+	const int kBand = 8;
+	for (int y0 = 0; y0 < _h; y0 += kBand) {
+		const int y1 = MIN(y0 + kBand, _h);
+		int left = _w, right = -1;
+		for (int y = y0; y < y1; y++) {
+			const byte *sh = _shadow.data() + y * _w;
+			const byte *ca = _cycleArea.data() + y * _w;
+			int x = 0;
+			while (x < left && !changed[sh[x]] && !ca[x])
+				x++;
+			if (x == _w)
+				continue;
+			left = MIN(left, x);
+			x = _w - 1;
+			while (x > right && !changed[sh[x]] && !ca[x])
+				x--;
+			right = MAX(right, x);
+		}
+		if (right >= left)
+			writeRect(left, y0, right - left + 1, y1 - y0);
+	}
+}
+
+void DigHD::moveScreen(int dx, int dy, int height) {
+	// Rarely used by v7; simplest correct behaviour is to move the shadow and redraw
+	Common::Array<byte> sh = _shadow;
+	Common::Array<uint32> so = _source;
+	for (int y = 0; y < MIN(height, _h); y++) {
+		for (int x = 0; x < _w; x++) {
+			int fx = x - dx, fy = y - dy;
+			if (fx >= 0 && fx < _w && fy >= 0 && fy < _h) {
+				_shadow[y * _w + x] = sh[fy * _w + fx];
+				_source[y * _w + x] = kSrcFlat;
+			}
+		}
+	}
+	writeRect(0, 0, _w, MIN(height, _h));
+}
+
+void DigHD::updateCursor(const byte *cursor, int width, int height, int hotspotX, int hotspotY, int transColor) {
+	_cursorPending = false;
+	const int n = _scale;
+	const int bpp = _fmt.bytesPerPixel;
+	const uint32 key = _fmt.aBits() ? _fmt.ARGBToColor(0, 255, 0, 255) : _fmt.RGBToColor(255, 0, 255);
+	Common::Array<byte> buf(width * n * height * n * bpp);
+	for (int y = 0; y < height * n; y++) {
+		for (int x = 0; x < width * n; x++) {
+			const byte i = cursor[(y / n) * width + (x / n)];
+			const uint32 col = (i == transColor) ? key : _fmt.RGBToColor(_pal[i * 3], _pal[i * 3 + 1], _pal[i * 3 + 2]);
+			byte *o = buf.data() + (y * width * n + x) * bpp;
+			if (bpp == 4) WRITE_UINT32(o, col); else WRITE_UINT16(o, col);
+		}
+	}
+	CursorMan.replaceCursor(buf.data(), width * n, height * n, hotspotX * n, hotspotY * n, key, &_fmt);
+}
+
+// ---------------------------------------------------------------- per frame
+
+void DigHD::beforeUpdateScreen() {
+	_frameNo++;
+	if (_cursorPending)
+		_vm->updateCursor();
+
+	if (_skipVideo && _vm->isSmushActive())
+		static_cast<ScummEngine_v7 *>(_vm)->_smushVideoShouldFinish = true;
+
+	if (_testRoom > 0 && !_testDone && (int)_frameNo >= _testAt && !_vm->isSmushActive()) {
+		_testDone = true;
+		debug("DigHD: test, jumping to room %d", _testRoom);
+		_vm->startScene(_testRoom, nullptr, 0);
+		if (_testCamX >= 0)
+			_vm->setCameraAt(_testCamX, _vm->camera._cur.y);
+		_vm->_fullRedraw = true;
+	}
+
+	for (uint i = 0; i < _testKeys.size(); i++) {
+		if (_testKeys[i].frame != (int)_frameNo)
+			continue;
+		// Goes through the engine's normal key handling on the next poll
+		Common::Event ev;
+		ev.type = Common::EVENT_KEYDOWN;
+		ev.kbd = Common::KeyState(_testKeys[i].keycode, _testKeys[i].keycode, _testKeys[i].flags);
+		g_system->getEventManager()->pushEvent(ev);
+		ev.type = Common::EVENT_KEYUP;
+		g_system->getEventManager()->pushEvent(ev);
+		debug("DigHD: test, key %d with flags %d at frame %u", (int)_testKeys[i].keycode, (int)_testKeys[i].flags, _frameNo);
+	}
+
+	if (_dumpEvery > 0 && !_dumpDir.empty() && (_frameNo % _dumpEvery) == 0)
+		dumpFrame();
+
+	if (_quitAt > 0 && (int)_frameNo >= _quitAt) {
+		debug("DigHD: frame %u, %s", _frameNo, statText().c_str());
+		Engine::quitGame();
+	}
+}
+
+bool DigHD::handleKey(const Common::KeyState &kbd, bool repeat) {
+	if (kbd.keycode != Common::KEYCODE_h)
+		return false;
+	if (kbd.hasFlags(Common::KBD_CTRL)) {
+		if (!repeat)
+			setClassic(!_classic);
+		return true;
+	}
+	if (kbd.hasFlags(Common::KBD_CTRL | Common::KBD_SHIFT)) {
+		if (!repeat)
+			setShowMissing(!_showMissing);
+		return true;
+	}
+	return false;
+}
+
+void DigHD::setClassic(bool on) {
+	_classic = on;
+	debug("DigHD: %s graphics", on ? "classic" : "HD");
+	g_system->displayMessageOnOSD(Common::U32String(on ? "Dig HD: klassisk grafikk" : "Dig HD: HD-grafikk"));
+	// Everything on screen is built again from the 8-bit picture right away
+	writeRect(0, 0, _w, _h);
+}
+
+void DigHD::setShowMissing(bool on) {
+	_showMissing = on;
+	debug("DigHD: missing HD in yellow %s", on ? "on" : "off");
+	g_system->displayMessageOnOSD(Common::U32String(on ? "Dig HD: gult der HD mangler" : "Dig HD: gult felt av"));
+	// Figures without HD are only looked for while the marking is on, so the
+	// game screen is sent through blitVirtScreen() again on the next frame.
+	if (on)
+		_vm->_virtscr[kMainVirtScreen].setDirtyRange(0, _vm->_virtscr[kMainVirtScreen].h);
+	writeRect(0, 0, _w, _h);
+}
+
+Common::String DigHD::statText() const {
+	Common::String s = Common::String::format("HD room px %u, HD object px %u, HD sprite px %u, original px %u",
+	                                          _statRoom, _statObject, _statCel, _statFlat);
+	if (_statSan)
+		s += Common::String::format(", HD film px %u", _statSan);
+	if (_statCycle)
+		s += Common::String::format(", cycled HD px %u", _statCycle);  // part of HD room/object px
+	if (_showMissing)
+		s += Common::String::format(", yellow px %u", _statMissing);
+	if (_classic)
+		s += ", classic";
+	return s;
+}
+
+void DigHD::dumpFrame() {
+	if (_verify) {
+		// The screen is built piece by piece (dirty areas, palette changes). It
+		// must look the same as the whole screen built again now.
+		compose(0, 0, _w, _h);
+		if (Graphics::Surface *scr = g_system->lockScreen()) {
+			const int bpp = _fmt.bytesPerPixel, rowBytes = _w * _scale * bpp;
+			uint32 stale = 0;
+			if (scr->w == _w * _scale && scr->h == _h * _scale && scr->format == _fmt) {
+				for (int y = 0; y < scr->h; y++) {
+					const byte *a = (const byte *)scr->getBasePtr(0, y);
+					const byte *b = _outBuf.data() + y * rowBytes;
+					if (!memcmp(a, b, rowBytes))
+						continue;
+					for (int i = 0; i < rowBytes; i += bpp)
+						stale += memcmp(a + i, b + i, bpp) != 0;
+				}
+				debug("DigHD: verify frame %u: %u screen pixels differ from the whole screen built again", _frameNo, stale);
+			}
+			g_system->unlockScreen();
+		}
+
+		// Compare the HD frame with a plain scaled-up frame. With a mod made with
+		// "nearest" the two must match; large differences mean misplaced HD pixels.
+		// The yellow marking is left out of the comparison.
+		const bool showMissing = _showMissing;
+		_showMissing = false;
+		compose(0, 0, _w, _h);
+		_showMissing = showMissing;
+		Common::Array<byte> hdCopy = _outBuf;
+		// Pixels in and next to cycled colours are interpolated smoothly between
+		// the original pixels on purpose, so they can differ from a "nearest" mod.
+		// They are counted on their own and left out of the main count.
+		Common::Array<byte> cycleArea = _cycleArea;
+		_forceFlat = true;
+		compose(0, 0, _w, _h);
+		_forceFlat = false;
+		const int n = _scale, outW = _w * n;
+		uint32 bad = 0, total = 0, cycBad = 0, cycTotal = 0;
+		const int bpp = _fmt.bytesPerPixel;
+		for (uint32 i = 0; i < (uint32)(outW * _h * n); i++) {
+			const uint32 a = bpp == 4 ? READ_UINT32(hdCopy.data() + i * 4) : READ_UINT16(hdCopy.data() + i * 2);
+			const uint32 b = bpp == 4 ? READ_UINT32(_outBuf.data() + i * 4) : READ_UINT16(_outBuf.data() + i * 2);
+			byte r1, g1, b1, r2, g2, b2;
+			_fmt.colorToRGB(a, r1, g1, b1);
+			_fmt.colorToRGB(b, r2, g2, b2);
+			const bool differs = ABS(r1 - r2) > 48 || ABS(g1 - g2) > 48 || ABS(b1 - b2) > 48;
+			if (cycleArea[(i / outW / n) * _w + (i % outW) / n]) {
+				cycTotal++;
+				cycBad += differs;
+			} else {
+				total++;
+				bad += differs;
+			}
+		}
+		debug("DigHD: verify frame %u: %u of %u HD pixels differ strongly from the original (%.3f%%)",
+		      _frameNo, bad, total, total ? 100.0 * bad / total : 0.0);
+		if (cycTotal)
+			debug("DigHD: verify frame %u: colour cycling, %u of %u HD pixels differ strongly (smooth colour map, left out above)",
+			      _frameNo, cycBad, cycTotal);
+		if (bad) {
+			Graphics::Surface fs;
+			fs.init(_w * _scale, _h * _scale, _w * _scale * bpp, _outBuf.data(), _fmt);
+			Common::FSNode fnode(_dumpDir.join(Common::String::format("frame_%06u_flat.png", _frameNo)));
+			Common::WriteStream *fws = fnode.createWriteStream();
+			if (fws) {
+				::Image::writePNG(*fws, fs);
+				fws->finalize();
+				delete fws;
+			}
+		}
+	}
+	// The dump is built the same way as the screen, so it shows what is on screen
+	compose(0, 0, _w, _h);
+	Graphics::Surface s;
+	s.init(_w * _scale, _h * _scale, _w * _scale * _fmt.bytesPerPixel, _outBuf.data(), _fmt);
+	const bool film = _vm->isSmushActive() && !_smushFile.empty();
+	const Common::String fname = film
+		? Common::String::format("frame_%06u_%s_%05d.png", _frameNo, _smushFile.c_str(), _smushFrameNo)
+		: Common::String::format("frame_%06u_room%03d.png", _frameNo, (int)_vm->_currentRoom);
+	Common::FSNode node(_dumpDir.join(fname));
+	Common::WriteStream *ws = node.createWriteStream();
+	if (ws) {
+		::Image::writePNG(*ws, s);
+		ws->finalize();
+		delete ws;
+	}
+	debug("DigHD: dumped frame %u (room %d, smush %d) %s",
+	      _frameNo, (int)_vm->_currentRoom, (int)_vm->isSmushActive(), statText().c_str());
+	if (film) {
+		// Where the pixels of this film frame come from, in original pixels
+		uint32 hd = 0, kept = 0, missing = 0;
+		for (uint i = 0; i < _source.size(); i++) {
+			if (_source[i] == kSrcSan)
+				hd++;
+			else if (_source[i] == kSrcFlatMissing)
+				missing++;
+			else
+				kept++;
+		}
+		if (_classic)
+			debug("DigHD: film %s frame %d: classic graphics, all %u px original",
+			      _smushFile.c_str(), _smushFrameNo, (uint32)_source.size());
+		else
+			debug("DigHD: film %s frame %d: %u px from HD frame, %u px original on purpose (text), %u px original without HD",
+			      _smushFile.c_str(), _smushFrameNo, hd, kept, missing);
+	} else if (_verify) {
+		// Which costumes the last drawing pass of each actor used, and how many
+		// of their cels have an HD image. Helps to test costumes one by one.
+		Common::String list;
+		for (int a = 0; a < kMaxCelSlots / kCelSlotsPerActor; a++) {
+			int costume = -1, hd = 0, without = 0;
+			for (int i = 0; i < kCelSlotsPerActor; i++) {
+				const CelSlot &cs = _cels[a * kCelSlotsPerActor + i];
+				if (!cs.used && !cs.missing)
+					continue;
+				costume = cs.costume;
+				if (cs.used)
+					hd++;
+				else
+					without++;
+			}
+			if (costume >= 0)
+				list += Common::String::format("%sactor %d costume %d (%d cels HD, %d without)",
+				                               list.empty() ? "" : ", ", a, costume, hd, without);
+		}
+		if (!list.empty())
+			debug("DigHD: costumes drawn: %s", list.c_str());
+	}
+	if (_bench > 0) {
+		// Time to build the whole screen and send it, as after every palette
+		// change (fades, colour cycling). Includes copyRectToScreen().
+		const uint32 start = g_system->getMillis();
+		for (int i = 0; i < _bench; i++)
+			writeRect(0, 0, _w, _h);
+		const uint32 ms = g_system->getMillis() - start;
+		debug("DigHD: bench frame %u: whole screen %.2f ms (mean of %d)", _frameNo, (double)ms / _bench, _bench);
+		if (_anyCycled) {
+			// What one step of colour cycling builds again: the cycled colours
+			const uint32 start2 = g_system->getMillis();
+			for (int i = 0; i < _bench; i++)
+				redrawColors(_cycled);
+			const uint32 ms2 = g_system->getMillis() - start2;
+			debug("DigHD: bench frame %u: colour cycling step %.2f ms (mean of %d)", _frameNo, (double)ms2 / _bench, _bench);
+		}
+	}
+	_statRoom = _statObject = _statCel = _statSan = _statFlat = _statMissing = _statCycle = 0;
+}
+
